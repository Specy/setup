# Normalise everything to LF in the repository.
* text=auto eol=lf

# These are consumed by Linux and MUST be LF on checkout, on any host.
# CRLF here produces: bad interpreter: /bin/bash^M
*.sh      text eol=lf
*.bash    text eol=lf
*.zsh     text eol=lf
*.conf    text eol=lf
*.toml    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Consumed by Windows tooling.
*.ps1     text eol=crlf
*.psm1    text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Never touch these.
*.png     binary
*.jpg     binary
*.ico     binary
*.tar     binary
*.vhdx    binary
